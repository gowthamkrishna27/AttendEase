// prisma/schema.prisma
//
// Prisma 7 schema — datasource URL moved to prisma.config.ts (see that file).
// This file contains only the data model definitions.
//
// When you're ready to switch to Neon:
//   1. Set DATABASE_URL in .env  (get it from console.neon.tech)
//   2. npx prisma migrate dev --name init
//   3. Change 2 import lines in the services (see SWITCH_TO_PRISMA.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // In Prisma 7, the connection URL lives in prisma.config.ts, not here.
  // This provider declaration is still required for the schema parser.
  provider = "postgresql"
}

// ── User ─────────────────────────────────────────────────────────────────────
// Stores students, faculty, HOD, and admin accounts in a single table.
// Discriminated by the `role` enum field — mirrors the current Mongoose model.

model User {
  id         String   @id @default(cuid())
  userId     String   @unique                // human-readable id, e.g. "stu-24B91A0720"
  name       String
  email      String   @unique
  role       UserRole
  department String
  password   String                          // bcrypt hash — never exposed in responses
  rollNumber String?
  semester   Int?
  avatarUrl  String?
  phone      String?
  dob        String?
  gender     String?
  address    String?
  isActive   Boolean  @default(true)         // false = soft-deleted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([rollNumber])                      // fast lookup for import dedup
  @@index([isActive])                        // all list queries filter on isActive
  @@index([email])                           // email uniqueness checks
  @@index([role, isActive])                  // role-filtered counts (e.g. countActiveAdmins)
}

enum UserRole {
  student
  faculty
  hod
  admin
}

// ── Request ───────────────────────────────────────────────────────────────────
// Attendance permission requests submitted by students.
// `student` and `faculty` are stored as Json snapshots (denormalized) to match
// the existing MongoDB approach and avoid join complexity during migration.

model Request {
  id              String        @id @default(cuid())
  requestId       String        @unique       // human-readable id, e.g. "req-001"
  studentId       String                      // userId of the submitting student
  student         Json                        // snapshot at submission time
  reason          String
  reasonLabel     String
  date            String
  startTime       String
  endTime         String
  description     String
  documentName    String?
  status          RequestStatus @default(pending)
  submittedAt     String
  facultyId       String?
  faculty         Json?                       // snapshot of assigned faculty
  reviewedAt      String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
}

enum RequestStatus {
  pending
  approved
  rejected
}
